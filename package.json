{
  "name": "robson-svicero-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-content-snapshots.mjs && node scripts/generate-sitemap.mjs && vite build && node scripts/generate-static-pages-html.mjs && node scripts/generate-blog-html.mjs",
    "build:snapshots": "node scripts/generate-content-snapshots.mjs",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prestart": "npm run build",
    "start": "node server.js"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-color": "^3.32.3",
    "@tiptap/extension-highlight": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-link": "^3.32.3",
    "@tiptap/extension-text-align": "^3.32.3",
    "@tiptap/extension-text-style": "^3.32.3",
    "@tiptap/extension-underline": "^3.32.3",
    "@tiptap/extension-youtube": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@vitejs/plugin-react": "^6.2.1",
    "browserslist": "^4.29.5",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-ga4": "^3.0.1",
    "react-router-dom": "^7.18.5",
    "source-map-js": "^1.2.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch": "^11.0.1"
  }
